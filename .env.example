# Copie para .env e ajuste. O arquivo .env não é versionado.

# Senha do SQL Server. Exige 8+ caracteres com maiúscula, minúscula e número.
MSSQL_SA_PASSWORD=Your_password123

# Chave de assinatura do JWT — mínimo de 32 caracteres.
# Gere uma com: openssl rand -base64 48
JWT_SIGNING_KEY=troque-por-uma-chave-longa-e-aleatoria-de-32-caracteres-ou-mais
